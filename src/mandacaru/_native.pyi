from typing import Sequence, TypedDict
import numpy as np
from numpy.typing import NDArray

ABI_VERSION: int
THREAD_POLICY_VERSION: int

class Geometry:
    def __init__(self, numbers: Sequence[int], positions: NDArray[np.float64],
                 cell: NDArray[np.float64], pbc: Sequence[bool] = ...,
                 units: str = "angstrom") -> None: ...
    @property
    def numbers(self) -> list[int]: ...
    @property
    def pbc(self) -> list[bool]: ...
    @property
    def positions_bohr(self) -> NDArray[np.float64]: ...
    @property
    def cell_bohr(self) -> NDArray[np.float64]: ...

class Grid:
    def __init__(self, shape: Sequence[int], inverse_metric: NDArray[np.float64], dv_bohr3: float) -> None: ...
    @staticmethod
    def orthogonal(shape: Sequence[int], spacing_bohr: Sequence[float]) -> Grid: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def points(self) -> int: ...
    @property
    def dv_bohr3(self) -> float: ...
    @property
    def inverse_metric(self) -> NDArray[np.float64]: ...

class Workspace:
    def to_numpy(self) -> NDArray[np.float64]: ...
    def fill(self, value: float) -> None: ...

class Context:
    def xc_points(self, functional: str, variables: NDArray[np.float64], *, relativistic: bool = False) -> NDArray[np.float64]: ...
    def exchange_hole(self, variables: NDArray[np.float64], *, omega: float = 0.11) -> NDArray[np.float64]: ...
    def hybrid_points(self, variables: NDArray[np.float64], *, omega: float = 0.11, exact_fraction: float = 0.25) -> NDArray[np.float64]: ...
    def nonlocal_correlation(self, grid: SpatialGrid, density: NDArray[np.float64], sigma: NDArray[np.float64], *, b: float = 11.95, c: float = 0.0093, q_min: float = 1e-4, q_cut: float = 0.5, nodes: int = 16, padding: int = 2) -> dict: ...
    def read_snapshot(self, path: str, kind: str) -> Snapshot: ...
    def parse_snapshot(self, text: str, kind: str) -> Snapshot: ...
    def qwc_groups(self, labels: Sequence[str], weights: Sequence[float] | None = None) -> list[tuple[str, list[int]]]: ...
    def count_expectations(self, labels: Sequence[str], counts: Sequence[tuple[str, float]]) -> list[float]: ...
    def compile_circuit(self, num_qubits: int, occupied: Sequence[int], generators: Sequence[Sequence[tuple[str, float, float]]], parameters: Sequence[float]) -> list[tuple[str, int, int | None, float | None]]: ...
    def run_ledger(self, *, jobs: int | None = None, total_shots: int | None = None) -> RunLedger: ...
    def write_field(self, path: str, data: NDArray[np.float64], origin: Sequence[float], step: Sequence[Sequence[float]], numbers: Sequence[int], positions: Sequence[Sequence[float]], *, format: str = "cube", charges: Sequence[float] | None = None, cell: Sequence[Sequence[float]] | None = None, periodic: bool = False, comment: str = "") -> None: ...
    def write_bands(self, path: str, energies: NDArray[np.float64], reciprocal_cell: Sequence[Sequence[float]], fermi_level: float, *, comment: str = "Mandacaru band energies") -> None: ...
    def __init__(self, threads: int | None = None, memory_limit_bytes: int = 536870912) -> None: ...
    @property
    def threads(self) -> int: ...
    @property
    def memory_limit_bytes(self) -> int: ...
    @property
    def memory_used_bytes(self) -> int: ...
    @property
    def memory_peak_bytes(self) -> int: ...
    @property
    def worker_peak(self) -> int: ...
    @property
    def workers_launched(self) -> int: ...
    def workspace(self, elements: int) -> Workspace: ...
    def pauli_operator(self, num_qubits: int, terms: Sequence[tuple[str, float, float]]) -> PauliOperator: ...
    def propagator(self, num_qubits: int, terms: Sequence[tuple[str, float, float]], *, order: int = 2) -> Propagator: ...
    def mp2(self, one: NDArray[np.complex128], two: NDArray[np.complex128], occupied: int) -> dict: ...
    def mp2_from_block(self, oovv: NDArray[np.float64], energies: NDArray[np.float64], occupied: int, canonical: NDArray[np.float64]) -> dict: ...
    def fermion_operator(self, n_modes: int, num_particles: Sequence[int], terms: Sequence[tuple[Sequence[tuple[int, bool]], float, float]], *, mapping: str = "jordan_wigner") -> PauliOperator: ...
    def load_hamiltonian(self, path: str, *, sector: bool = True, dense: bool = False, include_singles: bool = True, sparse: bool = False) -> QuantumProblem: ...
    def periodic_problem(self, snapshot_json: str) -> PeriodicProblem: ...
    def load_crystal(self, path: str) -> PeriodicProblem: ...
    def kmesh(self, size: Sequence[int], *, gamma: bool = False, rotations: Sequence[Sequence[int]] = (), time_reversal: bool = True) -> dict: ...
    def fermi_distribution(self, eigenvalues: Sequence[Sequence[float]], weights: Sequence[float], electrons: float, *, method: str = "fermi-dirac", width_ha: float = ..., degeneracy: float = 2.) -> dict: ...
    def ewald(self, positions_bohr: NDArray[np.float64], charges: NDArray[np.float64], cell_bohr: NDArray[np.float64], *, accuracy: float = 1e-12, eta: float | None = None, points_bohr: NDArray[np.float64] | None = None, softening_bohr: float = 0.) -> dict: ...
    def wilson_loop(self, links: NDArray[np.complex128], *, tolerance: float = 1e-10) -> tuple[float, float]: ...
    def sample_basis(self, geometry: Geometry, coordinates: NDArray[np.float64], *, basis_spec: str = '{"name":"HAO"}') -> NDArray[np.float64]: ...
    def molecular_integrals(self, geometry: Geometry, *, basis_spec: str = '{"name":"HAO"}', spacing_bohr: float = ..., grid: SpatialGrid | None = None, kinetic: str = "spectral", cholesky_tolerance: float | None = None) -> MolecularIntegrals: ...
    def solve_atom(self, atomic_number: int, *, points: int = 4000, r_max: float = 25., max_iterations: int = 200, tolerance: float = 1e-6, mixing: float = .3, configuration: Sequence[tuple[int, int, float]] | None = None, confinement: NDArray[np.float64] | None = None) -> dict: ...
    def confined_radial(self, n: int, l: int, charge: float, radius_bohr: float, *, intervals: int = 2000) -> dict: ...
    def exchange_correlation(self, grid: SpatialGrid, densities: NDArray[np.float64], *, functional: str = "lda", kinetic_densities: NDArray[np.float64] | None = None) -> dict: ...
    def poisson(self, grid: SpatialGrid, density: NDArray[np.complex128], *, periodic: bool = False, slab_axis: int | None = None) -> NDArray[np.complex128]: ...
    def laplacian(self, grid: Grid, fields: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def laplacian_f32(self, grid: Grid, fields: NDArray[np.float32]) -> NDArray[np.float32]: ...
    def one_body(self, grid: Grid, orbitals: NDArray[np.complex128], potential: NDArray[np.float64]) -> tuple[NDArray[np.complex128], NDArray[np.complex128]]: ...
    def project(self, dv_bohr3: float, orbitals: NDArray[np.complex128], projectors: NDArray[np.complex128]) -> NDArray[np.complex128]: ...
    def bessel(self, l: int, radii: NDArray[np.float64], wave_numbers: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def fourier_bessel(self, l: int, radii: NDArray[np.float64], weighted: NDArray[np.float64], wave_numbers: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def eigenpair(self, diagonal: NDArray[np.float64], off_diagonal: NDArray[np.float64], index: int) -> tuple[float, NDArray[np.float64]]: ...
    def numerov(self, coefficient: NDArray[np.float64], source: NDArray[np.float64], initial: NDArray[np.float64], step_squared: float, boundary: int, inward: bool = False) -> NDArray[np.float64]: ...
    def real_shell(self, coordinates: NDArray[np.float64], center: Sequence[float], support: float, knots: NDArray[np.float64], coefficients: NDArray[np.float64], cutoff: float, l: int, ms: NDArray[np.int32], derivative: int = -1) -> NDArray[np.float64]: ...

class PauliOperator:
    def qpe(self, state: NDArray[np.complex128], evaluation_qubits: int, window: Sequence[float], *, keep_amplitudes: bool = True) -> dict: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def terms(self) -> list[tuple[str, float, float]]: ...
    def dagger(self) -> PauliOperator: ...
    def add(self, other: PauliOperator, real: float = 1.0, imaginary: float = 0.0) -> PauliOperator: ...
    def compose(self, other: PauliOperator) -> PauliOperator: ...
    def commutator(self, other: PauliOperator) -> PauliOperator: ...
    def map_to(self, mapping: str, num_particles: Sequence[int]) -> PauliOperator: ...
    def matrix(self) -> NDArray[np.complex128]: ...
    def apply(self, state: NDArray[np.complex128]) -> NDArray[np.complex128]: ...

class Propagator:
    def evolve(self, state: NDArray[np.complex128], time: float, *, steps: int = 1, inverse: bool = False, normalized: bool = True) -> NDArray[np.complex128]: ...
    def apply(self, state: NDArray[np.complex128]) -> NDArray[np.complex128]: ...

class Snapshot:
    @property
    def json(self) -> str: ...
    def save(self, path: str) -> None: ...
    def state(self) -> NDArray[np.complex128]: ...
    def expectation(self) -> float: ...
    def problem(self, *, sector: bool = True, dense: bool = False, include_singles: bool = True, sparse: bool = False) -> QuantumProblem: ...

class RunLedger:
    def reserve(self, jobs: int, shots: int) -> list[int]: ...
    def finish(self, ticket: int, success: bool) -> None: ...
    @property
    def usage(self) -> dict[str, int]: ...

class QuantumEvaluation(TypedDict):
    energy_ha: float
    gradient: NDArray[np.float64]
    state: NDArray[np.complex128]

class QuantumResult(TypedDict):
    energy_ha: float
    reference_ha: float
    parameters: NDArray[np.float64]
    state: NDArray[np.complex128]
    success: bool
    message: str
    operators: list[str]
    indices: list[int]
    history_ha: list[float]
    optimizer_steps: int
    final_max_gradient: float
    elapsed_seconds: float
    iterations: list[tuple[int, float, float, int, int, bool, str]]

class QuantumProblem:
    def checkpoint(self, indices: Sequence[int], parameters: Sequence[float], *, product_form: bool = True, energy_ha: float, status_json: str = "{}", method: str = "adapt-vqe") -> Snapshot: ...
    def solve_subspace(self, weights: Sequence[float], *, adapt: bool = False, trotter: bool = False, optimizer: str = "BFGS", max_iterations: int = 300, max_evaluations: int = 5000, tolerance: float = 1e-9, max_growth: int = 50, gradient_tolerance: float | None = 1e-7, energy_tolerance: float | None = None, initial_parameters: Sequence[float] | None = None) -> dict: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def n_spatial_orbitals(self) -> int: ...
    @property
    def num_particles(self) -> list[int]: ...
    @property
    def mapping(self) -> str: ...
    @property
    def dimension(self) -> int: ...
    @property
    def basis_indices(self) -> NDArray[np.uint64]: ...
    @property
    def pool_labels(self) -> list[str]: ...
    @property
    def pool_terms(self) -> list[list[tuple[str, float, float]]]: ...
    @property
    def hamiltonian_terms(self) -> list[tuple[str, float, float]]: ...
    def evaluate(self, parameters: Sequence[float], *, trotter: bool = False, indices: Sequence[int] | None = None) -> QuantumEvaluation: ...
    def rdms(self, state: NDArray[np.complex128], *, two_body: bool = True) -> tuple[NDArray[np.complex128], NDArray[np.complex128] | None]: ...
    def solve(self, *, adapt: bool = False, trotter: bool = False, max_growth: int = 50, gradient_tolerance: float | None = 1e-7, energy_tolerance: float | None = None, max_iterations: int = 300, max_evaluations: int = 5000, tolerance: float = 1e-9, initial_parameters: Sequence[float] | None = None, optimizer: str = "BFGS", resume: Snapshot | None = None) -> QuantumResult: ...

class SpatialGrid:
    def __init__(self, shape: Sequence[int], origin_bohr: Sequence[float], step_bohr: NDArray[np.float64], *, periodic: bool = False) -> None: ...
    @staticmethod
    def from_geometry(geometry: Geometry, spacing_bohr: Sequence[float], *, periodic: bool = False, skew: bool = False) -> SpatialGrid: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def origin_bohr(self) -> list[float]: ...
    @property
    def step_bohr(self) -> NDArray[np.float64]: ...
    @property
    def dv_bohr3(self) -> float: ...
    @property
    def points(self) -> int: ...
    @property
    def periodic(self) -> bool: ...

class MolecularIntegrals:
    @property
    def n_orbitals(self) -> int: ...
    @property
    def grid(self) -> SpatialGrid: ...
    @property
    def resolution_ratios(self) -> list[float]: ...
    def snapshot(self, *, include_samples: bool = False) -> dict: ...
    def particles(self, *, charge: int = 0, magnetic_moment: float = 0.0, n_electrons: int | None = None) -> list[int]: ...
    def mean_field(self, method: str, num_particles: Sequence[int], *, max_iterations: int = 300, tolerance: float = 1e-9, diis: bool = True, guesses: int = 3) -> MeanField: ...

    def kohn_sham(self, functional: str, num_particles: Sequence[int], *, unrestricted: bool = False, max_iterations: int = 300, tolerance: float = 1e-9, diis: bool = True, guesses: int = 3) -> MeanField: ...

class MeanField:
    def gradient(self) -> dict[str, NDArray[np.float64]]: ...
    @property
    def converged(self) -> bool: ...
    @property
    def model(self) -> MolecularModel: ...
    def active_model(self, spec: str) -> MolecularModel: ...
    def snapshot(self) -> dict: ...
    def state(self, mapping: str = "jordan_wigner") -> NDArray[np.complex128]: ...
    def rdm(self) -> NDArray[np.complex128]: ...

class MolecularModel:
    def mp2(self) -> dict: ...
    @property
    def context(self) -> Context: ...
    @property
    def orbital_indices(self) -> list[int]: ...
    @property
    def frozen_indices(self) -> list[int]: ...
    @property
    def n_spatial_orbitals(self) -> int: ...
    @property
    def num_particles(self) -> list[int]: ...
    @property
    def constant_energy(self) -> float: ...
    @property
    def spinor(self) -> bool: ...
    def reduce(self, frozen: Sequence[int], active: Sequence[int]) -> MolecularModel: ...
    def fermion_terms(self) -> list[tuple[list[tuple[int, bool]], float, float]]: ...
    def operator(self, mapping: str = "jordan_wigner") -> PauliOperator: ...
    def problem(self, *, mapping: str = "jordan_wigner", sector: bool = True, dense: bool = False, include_singles: bool = True, sparse: bool = False) -> QuantumProblem: ...
    def reference_state(self, mapping: str = "jordan_wigner") -> NDArray[np.complex128]: ...
    def save(self, path: str, *, mapping: str = "jordan_wigner") -> None: ...


class PeriodicProblem:
    @property
    def context(self) -> Context: ...
    @property
    def functional(self) -> str: ...
    @property
    def spins(self) -> int: ...
    @property
    def n_orbitals(self) -> int: ...
    def save(self, path: str) -> None: ...
    def solve(self, *, max_iterations: int = 300, tolerance: float = 1e-7, density_tolerance: float = 1e-5, smearing: str = "fermi-dirac", width_ha: float = ..., mixing: float = .25, history: int = 7) -> PeriodicResult: ...

class PeriodicResult:
    @property
    def converged(self) -> bool: ...
    def snapshot(self) -> dict: ...
    def bands(self, data_json: str) -> dict: ...
    def dos(self, energies_ha: NDArray[np.float64], *, width_ha: float, projected: bool = False) -> NDArray[np.float64]: ...
    def projectability(self, trials: NDArray[np.complex128]) -> dict: ...
