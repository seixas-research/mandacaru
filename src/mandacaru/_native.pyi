class ParquetTable(TypedDict):
    num_rows: int
    columns: dict[str, NDArray[np.float64] | list[str]]
    metadata: dict[str, str]

class ParquetFooter(TypedDict):
    num_rows: int
    num_row_groups: int
    created_by: str
    columns: list[tuple[str, str]]
    metadata: dict[str, str]

class Geometry:
    def __init__(self, numbers: Sequence[int], positions: NDArray[np.float64],
                 cell: NDArray[np.float64], pbc: Sequence[bool] = ...,
                 units: str = "angstrom") -> None: ...
    @property
    def numbers(self) -> list[int]: ...
    @property
    def pbc(self) -> list[bool]: ...
    @property
    def positions_bohr(self) -> NDArray[np.float64]: ...
    @property
    def cell_bohr(self) -> NDArray[np.float64]: ...

class Grid:
    def __init__(self, shape: Sequence[int], inverse_metric: NDArray[np.float64], dv_bohr3: float) -> None: ...
    @staticmethod
    def orthogonal(shape: Sequence[int], spacing_bohr: Sequence[float]) -> Grid: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def points(self) -> int: ...
    @property
    def dv_bohr3(self) -> float: ...
    @property
    def inverse_metric(self) -> NDArray[np.float64]: ...

class Workspace:
    def to_numpy(self) -> NDArray[np.float64]: ...
    def fill(self, value: float) -> None: ...

