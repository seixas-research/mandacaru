class PauliOperator:
    def qpe(self, state: NDArray[np.complex64] | NDArray[np.complex128], evaluation_qubits: int, window: Sequence[float], *, keep_amplitudes: bool = True, precision: str = "float64") -> dict: ...
    def qpe_window(self, evaluation_qubits: int, window: tuple[float, float] | None = None) -> tuple[float, float]:
        """``window``, or the Gershgorin bound ``c_I -+ sum |c_P|``, widened by ``1 + 2/2^t`` (``dynamics::qpe_window``)."""
    @property
    def num_qubits(self) -> int: ...
    @property
    def terms(self) -> list[tuple[str, float, float]]: ...
    def dagger(self) -> PauliOperator: ...
    def add(self, other: PauliOperator, real: float = 1.0, imaginary: float = 0.0) -> PauliOperator: ...
    def compose(self, other: PauliOperator) -> PauliOperator: ...
    def commutator(self, other: PauliOperator) -> PauliOperator: ...
    def map_to(self, mapping: str, num_particles: Sequence[int]) -> PauliOperator: ...
    def hermitian_part(self) -> PauliOperator:
        """``(A + A^dagger) / 2``: the real parts of the coefficients (``Operator::hermitian_part``)."""
    def matrix(self) -> NDArray[np.complex128]: ...
    def sparse_matrix(self) -> CSRMatrix:
        """The matrix on the whole register in compressed rows with sorted columns (``Operator::csr``)."""
    def apply(self, state: NDArray[np.complex128]) -> NDArray[np.complex128]: ...

class Propagator:
    def schedule(self) -> tuple[float, list[tuple[str, float]]]: ...
    def circuit_plan(self, time: float, steps: int) -> tuple[float, list[tuple[str, float]]]:
        """``(global phase, [(label, angle)])`` of an exported circuit of ``steps`` slices of ``time``: ``-time constant`` and, for one slice, ``time weight / steps`` per ordered rotation (``Propagator::circuit_plan``)."""
    @property
    def precision(self) -> str: ...
    def evolve(self, state: NDArray[np.complex64] | NDArray[np.complex128], time: float, *, steps: int = 1, inverse: bool = False, normalized: bool = True) -> NDArray[np.complex64] | NDArray[np.complex128]: ...
    def apply(self, state: NDArray[np.complex64] | NDArray[np.complex128]) -> NDArray[np.complex64] | NDArray[np.complex128]: ...
    def echo_correlation(self, kick: Propagator, state: NDArray[np.complex64] | NDArray[np.complex128], dt: float, samples: int, steps: int) -> NDArray[np.complex128]:
        """``C(t_i) = <U(t_i) V psi | V U(t_i) psi>`` at ``t_i = i dt``, ``V`` the operator of ``kick`` (``Propagator::echo_correlation``)."""
    def nested_otoc(self, butterfly: Propagator, measurement: Propagator, state: NDArray[np.complex64] | NDArray[np.complex128], time: float, steps: int, order: int, tolerance: float) -> tuple[NDArray[np.complex64] | NDArray[np.complex128], tuple[float, float], float, int | None]:
        """``(U_k psi, C^(2k) as (re, im), <M>, eigenvalue)`` with the one-branch form for an initial M eigenstate (``Propagator::nested_otoc``)."""
    def nested_otoc_series(self, butterfly: Propagator, measurement: Propagator, state: NDArray[np.complex64] | NDArray[np.complex128], dt: float, samples: int, steps: int, order: int, tolerance: float) -> NDArray[np.complex128]:
        """``C^(2k)(j dt)``, ``j < samples``, sample ``j`` sliced into ``max(1, j steps)`` steps per leg (``Propagator::nested_otoc_series``)."""

